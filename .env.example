 # ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_MS=604800000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Use MongoDB Atlas URI (M0 free tier) for replica set + transaction support
# Local dev: use docker-compose.yml (starts single-node replica set rs0)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/feedback_system?retryWrites=true&w=majority

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# ⚠️  NEVER expose this key to the frontend — server-side only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=feedback-attachments

# ─── Microsoft Teams ──────────────────────────────────────────────────────────
# Power Automate / Workflows HTTP trigger URL (NOT the legacy Office 365 connector)
TEAMS_FEEDBACK_WEBHOOK_URL=https://prod-00.westus.logic.azure.com/workflows/...

# ─── Feedback Configuration ───────────────────────────────────────────────────
FEEDBACK_MAX_ATTACHMENTS=5
FEEDBACK_MAX_FILE_SIZE_MB=5
FEEDBACK_DESCRIPTION_MIN_LENGTH=10
FEEDBACK_DESCRIPTION_MAX_LENGTH=5000
FEEDBACK_SIGNED_URL_EXPIRES_SECONDS=3600
FEEDBACK_UPLOAD_URL_EXPIRES_SECONDS=300
FEEDBACK_ORPHAN_CLEANUP_GRACE_MINUTES=60
FEEDBACK_RATE_LIMIT_WINDOW_MS=900000
FEEDBACK_RATE_LIMIT_MAX_REQUESTS=20

